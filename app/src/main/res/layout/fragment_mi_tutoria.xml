<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_page">

    <!-- ── APP BAR — solo tabs (FIX 3: sin avatar ni título) ── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_primary"
        app:elevation="0dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/purple_primary"
            app:tabTextColor="#99FFFFFF"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabIndicatorColor="#FFFFFF"
            app:tabIndicatorHeight="2dp"
            app:tabRippleColor="#22FFFFFF"
            app:tabPaddingStart="0dp"
            app:tabPaddingEnd="0dp">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi tutor"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar tutor"/>

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial"/>
        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── CONTENIDO SCROLLABLE ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══════════════════════════════════
                 SECCIÓN 0: MI TUTOR
                 ══════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/sec_tutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Alerta: sin correo registrado -->
                <LinearLayout
                    android:id="@+id/email_alert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_warning"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="top"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="2dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registra tu correo electrónico"
                            android:textColor="#92400E"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Es necesario para recibir notificaciones de tu tutor y comunicados institucionales."
                            android:textColor="#92400E"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"/>

                        <Button
                            android:id="@+id/btn_registrar_correo"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Registrar correo"
                            android:textColor="#92400E"
                            android:textSize="12sp"
                            android:paddingStart="0dp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Tarjeta: Sin tutor asignado -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/no_tutor_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    app:cardBackgroundColor="@color/background_card"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="28dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎓"
                            android:textSize="36sp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aún no tienes tutor asignado"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:gravity="center"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Es tu primer semestre. Elige al tutor que te acompañará en tu trayectoria académica."
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginBottom="18dp"/>

                        <Button
                            android:id="@+id/btn_ir_cambiar"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Seleccionar tutor"
                            android:backgroundTint="@color/purple_primary"
                            android:textColor="#FFFFFF"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tarjeta: Tutor asignado -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/tutor_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    app:cardBackgroundColor="@color/background_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header de tarjeta -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_icon_purple"
                                android:gravity="center"
                                android:text="👤"
                                android:textSize="14sp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tutor asignado"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>

                                <TextView
                                    android:id="@+id/tv_periodo_actual"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"
                                    tools:text="Periodo 2025-2026-A"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_tipo_asignacion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_green"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#065F46"
                                tools:text="Continuidad"/>
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/border_default"/>

                        <!-- Datos del tutor -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tv_nombre_tutor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="3dp"
                                tools:text="M.C. JUÁREZ HERNÁNDEZ JOSÉ DOMINGO"/>

                            <TextView
                                android:id="@+id/tv_carrera_tutor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="10dp"
                                tools:text="Ingeniería en Computación"/>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="14dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✉ "
                                    android:textSize="13sp"
                                    android:textColor="@color/purple_primary"/>

                                <TextView
                                    android:id="@+id/tv_correo_tutor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="13sp"
                                    android:textColor="@color/purple_primary"
                                    tools:text="jdomingo@unpa.edu.mx"/>
                            </LinearLayout>

                            <!-- Filas de info -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Estado"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"/>

                                <TextView
                                    android:id="@+id/tv_estado_tutor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#065F46"
                                    tools:text="Activo"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tarjeta: Correo del alumno -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    app:cardBackgroundColor="@color/background_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_icon_blue"
                                android:gravity="center"
                                android:text="✉"
                                android:textSize="14sp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tu correo electrónico"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="10dp"/>
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/border_default"/>

                        <!-- Fila correo + botón actualizar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tv_correo_alumno"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary"
                                tools:text="carlos.cardoza@unpa.edu.mx"/>

                            <TextView
                                android:id="@+id/btn_actualizar_correo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Actualizar"
                                android:textSize="12sp"
                                android:textColor="@color/purple_primary"
                                android:textStyle="bold"
                                android:padding="4dp"
                                android:clickable="true"
                                android:focusable="true"/>
                        </LinearLayout>

                        <!-- Sección inline de actualizar correo -->
                        <LinearLayout
                            android:id="@+id/sec_correo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp"
                            android:paddingTop="0dp"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Tu correo electrónico"
                                app:boxCornerRadiusTopStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusBottomEnd="10dp"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_marginBottom="10dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_correo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textEmailAddress"
                                    android:textSize="13sp"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <Button
                                android:id="@+id/btn_guardar_correo"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="Guardar correo"
                                android:backgroundTint="@color/purple_primary"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ══════════════════════════════════
                 SECCIÓN 1: CAMBIAR TUTOR
                 ══════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/sec_cambiar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Tarjeta: Motivo del cambio (solo si ya tiene tutor) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/motivo_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    app:cardBackgroundColor="@color/background_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_icon_amber"
                                android:gravity="center"
                                android:text="💬"
                                android:textSize="14sp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Motivo del cambio"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Requerido para cambiar tutor"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/border_default"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Selecciona el motivo principal"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="8dp"/>

                            <!-- Chips de motivo -->
                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chip_group_motivo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:singleSelection="true"
                                android:layout_marginBottom="12dp">

                                <com.google.android.material.chip.Chip
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cambio de carrera"
                                    style="@style/Widget.MaterialComponents.Chip.Choice"
                                    app:chipBackgroundColor="@color/chip_bg_selector"
                                    app:checkedIconVisible="false"/>

                                <com.google.android.material.chip.Chip
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Dificultad de horario"
                                    style="@style/Widget.MaterialComponents.Chip.Choice"
                                    app:chipBackgroundColor="@color/chip_bg_selector"
                                    app:checkedIconVisible="false"/>

                                <com.google.android.material.chip.Chip
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Preferencia personal"
                                    style="@style/Widget.MaterialComponents.Chip.Choice"
                                    app:chipBackgroundColor="@color/chip_bg_selector"
                                    app:checkedIconVisible="false"/>

                                <com.google.android.material.chip.Chip
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Recomendación"
                                    style="@style/Widget.MaterialComponents.Chip.Choice"
                                    app:chipBackgroundColor="@color/chip_bg_selector"
                                    app:checkedIconVisible="false"/>
                            </com.google.android.material.chip.ChipGroup>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Detalle (opcional)"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="6dp"/>

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                app:boxCornerRadiusTopStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusBottomEnd="10dp"
                                android:hint="Escribe aquí si quieres agregar algo más…">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_motivo_detalle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textMultiLine"
                                    android:lines="2"
                                    android:maxLines="4"
                                    android:textSize="13sp"/>
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tarjeta: Selector de tutor por carrera -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    app:cardBackgroundColor="@color/background_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_icon_purple"
                                android:gravity="center"
                                android:text="🔍"
                                android:textSize="14sp"/>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Buscar tutor por carrera"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginStart="10dp"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/border_default"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carrera"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="6dp"/>

                            <!-- Spinner de carrera (Material style) -->
                            <Spinner
                                android:id="@+id/spinner_carrera"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_spinner"
                                android:paddingStart="12dp"
                                android:paddingEnd="36dp"
                                android:layout_marginBottom="14dp"/>

                            <!-- Lista de tutores (LinearLayout dinámico) -->
                            <LinearLayout
                                android:id="@+id/lista_tutores"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="14dp"/>

                            <!-- Loading tutores -->
                            <ProgressBar
                                android:id="@+id/progress_tutores"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:visibility="gone"/>

                            <Button
                                android:id="@+id/btn_confirmar_cambio"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:text="Confirmar cambio de tutor"
                                android:backgroundTint="@color/purple_primary"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ══════════════════════════════════
                 SECCIÓN 2: HISTORIAL
                 ══════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/sec_historial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    app:cardBackgroundColor="@color/background_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_icon_green"
                                android:gravity="center"
                                android:text="🕒"
                                android:textSize="14sp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Historial de tutores"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Todos los periodos"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:background="@color/border_default"/>

                        <!-- Items de historial (dinámico) -->
                        <LinearLayout
                            android:id="@+id/lista_historial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp"/>

                        <!-- Estado vacío -->
                        <TextView
                            android:id="@+id/tv_historial_vacio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No hay historial disponible"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:padding="24dp"
                            android:visibility="gone"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>