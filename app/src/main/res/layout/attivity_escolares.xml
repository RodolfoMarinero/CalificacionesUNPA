<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="16dp">

    <!-- Encabezado perfil (logo + nombre + matrícula + foto) -->
    <LinearLayout
        android:id="@+id/headerPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="8dp">

        <ImageView
            android:layout_width="62dp"
            android:layout_height="72dp"
            android:src="@drawable/he_logo_unpa"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servicios Escolares"
                    android:textSize="14sp"
                    android:textColor="#000000" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivPerfil"
                android:layout_width="59dp"
                android:layout_height="61dp"
                android:background="@drawable/bg_circle"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:src="@drawable/ic_perfil" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider para separar perfil de navegación -->
    <View
        android:id="@+id/dividerNav"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#80FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/headerPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Cargar Calendario Escolar (centro) -->
    <Button
        android:id="@+id/btnSeleccionarPdf"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="Cargar Calendario Escolar"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/dividerNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>

    <!-- CheckBox Subir nuevo calendario -->
    <CheckBox
        android:id="@+id/cbCalendarioActual"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Seleccionar como nuevo calendario"
        app:layout_constraintTop_toBottomOf="@id/btnSeleccionarPdf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"/>

    <!-- Botón Notificaciones (izquierda abajo) -->

    <!-- Botón Gestión de Calendarios (derecha abajo) -->

    <!-- Texto con el nombre del archivo seleccionado -->

    <Button
        android:id="@+id/btnNotificaciones"
        android:layout_width="187dp"
        android:layout_height="63dp"
        android:layout_marginTop="144dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#4CAF50"
        android:text="Gestionar Notificaciones"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnVerDocumentos"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cbCalendarioActual"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btnVerDocumentos"
        android:layout_width="179dp"
        android:layout_height="62dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="144dp"
        android:backgroundTint="#4CAF50"
        android:text="Gestionar Calendarios"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/btnNotificaciones"
        app:layout_constraintTop_toBottomOf="@id/cbCalendarioActual"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/txtNombreArchivo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintTop_toBottomOf="@id/btnNotificaciones"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:textStyle="italic"
        android:textColor="#000000" />

</androidx.constraintlayout.widget.ConstraintLayout>
