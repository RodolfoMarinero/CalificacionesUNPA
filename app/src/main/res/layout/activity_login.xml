<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_modern"> <ScrollView
    android:id="@+id/scrollContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/logo_universidad"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/unpa_logo_blue"
            android:contentDescription="Logo UNPA"
            android:layout_marginBottom="60dp" />

        <EditText
            android:id="@+id/cp_txtConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Matrícula"
            android:textColorHint="@color/unpa_cyan_xlight"
            android:textColor="@color/unpa_white"
            android:singleLine="true"
            android:imeOptions="actionNext"
            android:background="@drawable/bg_edittext_modern"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="20dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/cp_txtPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Contraseña"
                android:textColorHint="@color/unpa_cyan_xlight"
                android:textColor="@color/unpa_white"
                android:inputType="textPassword"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:background="@drawable/bg_edittext_modern"
                android:paddingStart="24dp"
                android:paddingEnd="60dp" />

            <ImageView
                android:id="@+id/togglePassword"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_visibility_off"
                android:contentDescription="Mostrar/Ocultar"
                app:tint="@color/unpa_primary_teal" />
        </RelativeLayout>



        <Button
            android:id="@+id/cp_changepass"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Iniciar Sesión"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_modern"
            android:textColor="@color/unpa_bg_dark"
            android:textAllCaps="false" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</ScrollView>

    <FrameLayout
        android:id="@+id/loadingFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"/>
</FrameLayout>