<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_tutor_item_selector"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Avatar con iniciales -->
    <TextView
        android:id="@+id/tv_iniciales"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_avatar_purple"
        android:gravity="center"
        android:textColor="@color/purple_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"
        tools:text="JD"/>

    <!-- Info del docente -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Nombre + badge "Tu tutor" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/tv_nombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="M.C. JUÁREZ HERNÁNDEZ JOSÉ DOMINGO"/>

            <TextView
                android:id="@+id/badge_actual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu tutor"
                android:background="@drawable/bg_badge_purple"
                android:textSize="10sp"
                android:textColor="@color/purple_primary"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="6dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Slots de texto -->
        <TextView
            android:id="@+id/tv_slots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"
            tools:text="8 / 13 tutorados"/>

        <!-- Barra de progreso de slots -->
        <ProgressBar
            android:id="@+id/bar_slots"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressDrawable="@drawable/progress_tutor_slots"
            android:max="13"
            android:progress="8"/>
    </LinearLayout>

    <!-- Indicador de selección (checkmark) -->
    <ImageView
        android:id="@+id/iv_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check_circle"
        android:tint="@color/purple_primary"
        android:layout_marginStart="8dp"
        android:visibility="invisible"
        android:contentDescription="Seleccionado"/>

</LinearLayout>