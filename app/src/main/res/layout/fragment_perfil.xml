<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAEA"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivProfile"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#AAAAAA"
        android:padding="20dp"
        android:src="@drawable/he_logo_unpa" /> <TextView
    android:id="@+id/tvNombre"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentStart="true"
    android:layout_toStartOf="@id/ivProfile"
    android:layout_marginTop="30dp"
    android:layout_marginEnd="16dp"
    android:text="Alam\nRivadeneyra\nZarate"
    android:textColor="@color/unpa_bg_dark"
    android:textSize="32sp"
    android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvNombre"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carrera:"
            android:textColor="@color/unpa_bg_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCarreraPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingeniería en Diseño"
            android:textColor="@color/unpa_bg_dark"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Matrícula:"
                    android:textColor="@color/unpa_bg_dark"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvMatriculaPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20020062"
                    android:textSize="18sp"
                    android:textColor="@color/unpa_bg_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Promedio:"
                    android:textColor="@color/unpa_bg_dark"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPromedioPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.1"
                    android:textSize="18sp"
                    android:textColor="@color/unpa_bg_dark" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBarcode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutDatos"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical">

<!--        <ImageView-->
<!--            android:id="@+id/ivBarcode"-->
<!--            android:layout_width="200dp"-->
<!--            android:layout_height="80dp"-->
<!--            android:scaleType="fitCenter"-->
<!--            android:src="@drawable/barcode_placeholder" />-->

<!--        <TextView-->
<!--            android:id="@+id/tvBarcodeNumber"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="20020062"-->
<!--            android:textColor="@color/unpa_bg_dark"-->
<!--            android:textStyle="italic" />-->
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutBarcode"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC" />

        <RelativeLayout
            android:id="@+id/btnHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial académico"
                android:textColor="@color/unpa_primary_teal"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_download_done"
                app:tint="@color/unpa_primary_teal" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC" />

        <RelativeLayout
            android:id="@+id/btnConstancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Constancia de estudios"
                android:textColor="@color/unpa_primary_teal"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_download_done"
                app:tint="@color/unpa_primary_teal" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePass"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cambiar contraseña"
            android:textColor="@color/unpa_primary_teal"
            app:cornerRadius="20dp"
            app:strokeColor="@color/unpa_primary_teal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cerrar Sesión"
            android:textColor="@color/unpa_primary_teal"
            app:cornerRadius="20dp"
            app:strokeColor="@color/unpa_primary_teal" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</RelativeLayout>
