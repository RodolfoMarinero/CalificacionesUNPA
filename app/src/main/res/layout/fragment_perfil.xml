<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:padding="16dp"
        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- Avatar centrado -->



            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginTop="60dp"
                android:src="@drawable/ic_perfil"
                android:background="@drawable/bg_circle"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:layout_marginBottom="12dp"/>

            <!-- Nombre -->
            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nina Salas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"/>


            <!-- Matrícula -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_light"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_badge"
                    android:contentDescription="@string/cd_matricula"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Matrícula:"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:id="@+id/tvMatriculaPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123456789"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Carrera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_light"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_school"
                    android:contentDescription="@string/cd_carrera"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carrera:"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:id="@+id/tvCarreraPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingeniería en Computación"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Promedio general -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_light"
                android:padding="12dp"
                android:layout_marginBottom="24dp">


                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star"
                    android:contentDescription="@string/cd_promedio"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Promedio:"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:id="@+id/tvPromedioPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9.45"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>


            <!-- Código de barras -->



            <TextView
                android:id="@+id/cambiarPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_google"
                android:gravity="center"
                android:text="Cambiar contraseña"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">



            <TextView
                    android:id="@+id/tvBarcodeNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="123456789"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivBarcode"
                    android:layout_width="200dp"
                    android:layout_height="80dp"
                    android:contentDescription="@string/cd_barcode"
                    android:src="@drawable/barcode_placeholder" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDescargarHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="16dp"
                    android:text="Descargar Historial Académico"
                    android:backgroundTint="#C1D8D2"
                    android:textColor="#000000"
                    android:gravity="center"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDescargarConstancia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="8dp"
                    android:text="Descargar Constancia de Estudios"
                    android:backgroundTint="#C1D8D2"
                    android:textColor="#000000"
                    android:gravity="center"/>

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Regresar" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Header con botón back y título -->
    <LinearLayout
        android:id="@+id/headerPerfil"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/tvTituloPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Perfil"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="#88000000" />

</FrameLayout>
