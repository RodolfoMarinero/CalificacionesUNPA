<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Línea de tiempo: punto + línea vertical -->
    <LinearLayout
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="12dp">

        <!-- Punto -->
        <View
            android:id="@+id/timeline_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_timeline_dot"
            android:layout_marginTop="5dp"/>

        <!-- Línea (visible en todos excepto el último item — se controla desde código) -->
        <View
            android:id="@+id/timeline_line"
            android:layout_width="1.5dp"
            android:layout_height="36dp"
            android:background="@color/border_default"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Contenido -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Periodo -->
        <TextView
            android:id="@+id/tv_periodo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="2dp"
            tools:text="2025-2026-A · Periodo actual"/>

        <!-- Nombre del tutor -->
        <TextView
            android:id="@+id/tv_nombre_hist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="2dp"
            tools:text="M.C. JUÁREZ HERNÁNDEZ JOSÉ DOMINGO"/>

        <!-- Tipo de asignación -->
        <TextView
            android:id="@+id/tv_tipo_hist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            tools:text="Continuidad"/>
    </LinearLayout>

</LinearLayout>