<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Periodo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                app:tint="#3730a3"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvPeriodo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="25-26A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1e293b" />

            <TextView
                android:id="@+id/tvFechaAsignacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01/03/2025"
                android:textSize="12sp"
                android:textColor="#94a3b8" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#e2e8f0"
            android:layout_marginBottom="12dp" />

        <!-- Info del tutor -->
        <TextView
            android:id="@+id/tvNombreTutor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Tutor"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvCarreraTutor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carrera"
            android:textSize="13sp"
            android:textColor="#64748b"
            android:layout_marginBottom="8dp" />

        <!-- Badge: Tipo de asignación -->
        <TextView
            android:id="@+id/tvTipoAsignacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elegido por ti"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#065f46"
            android:background="@drawable/badge_background"
            android:backgroundTint="#d1fae5"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>