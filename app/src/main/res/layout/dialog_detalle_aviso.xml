<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_edittext_modern" android:layout_margin="16dp">

    <LinearLayout
        android:id="@+id/dialogHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#8B0000" android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/dialogIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_warning"
            app:tint="@color/unpa_white" />

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Detalle del Aviso"
            android:textColor="@color/unpa_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnDialogClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            app:tint="@color/unpa_cyan_light" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/unpa_white"
        android:padding="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDialogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cuerpo completo del aviso..."
            android:textColor="@color/unpa_green_medium" android:textSize="16sp"
            android:lineSpacingExtra="4dp"/>

        <TextView
            android:id="@+id/tvDialogDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="29/03/26 10:00"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/unpa_white"
        android:paddingBottom="24dp"
        android:paddingHorizontal="24dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogEntendido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTENDIDO"
            android:textColor="@color/unpa_white"
            app:backgroundTint="@color/unpa_primary_teal" app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>