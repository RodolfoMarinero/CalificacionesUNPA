<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_modern"
    android:padding="32dp">

    <ImageView
        android:id="@+id/logo_universidad"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:src="@drawable/unpa_logo_blue"
        app:tint="@color/unpa_white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo_universidad"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/layout_actual_password"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edittext_modern">

            <EditText
                android:id="@+id/cp_txtActualPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Contraseña Actual"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/unpa_white"
                android:textColorHint="#BBFFFFFF" />

            <ImageView
                android:id="@+id/toggleActual"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/unpa_primary_teal" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edittext_modern">

            <EditText
                android:id="@+id/cp_txtnewPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Nueva Contraseña"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/unpa_white"
                android:textColorHint="#BBFFFFFF" />

            <ImageView
                android:id="@+id/toggleNew"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/unpa_primary_teal" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_edittext_modern">

            <EditText
                android:id="@+id/cp_txtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Confirmar Contraseña"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/unpa_white"
                android:textColorHint="#BBFFFFFF" />

            <ImageView
                android:id="@+id/toggleConfirm"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_visibility_off"
                app:tint="@color/unpa_primary_teal" />
        </RelativeLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cp_changepass"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Confirmar"
            android:textColor="@color/unpa_bg_dark"
            android:textStyle="bold"
            app:backgroundTint="@color/unpa_white"
            app:cornerRadius="25dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cp_cancelchangepass"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Volver"
            android:textColor="@color/unpa_white"
            app:cornerRadius="25dp"
            app:strokeColor="@color/unpa_white" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>