<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:padding="16dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">


        <!-- Título superior -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNIVERSIDAD DEL PAPALOAPAN"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E2E2E"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Logo de UNPA -->
            <ImageView
                android:id="@+id/logo_universidad"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/he_logo_unpa"
                android:contentDescription="Logo de la Universidad del Papaloapan"
                android:layout_marginBottom="16dp" />

            <!-- Card blanca redondeada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_margin="16dp"
                android:elevation="6dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:text="Cambiar Contraseña"
                    android:textColor="#333333"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/cp_txtActualPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Contraseña Actual"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textColor="#000" />

                <EditText
                    android:id="@+id/cp_txtnewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Nueva contraseña"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textColor="#000" />

                <EditText
                    android:id="@+id/cp_txtConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Confirmar Contraseña"
                    android:padding="12dp"
                    android:textColor="#000" />

                <Button
                    android:id="@+id/cp_changepass"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/gris_disabled"
                    android:text="Confirmar"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/cp_cancelchangepass"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/gris_unselected"
                    android:text="Cancelar"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <!-- Botón para crear cuenta -->
            <Button
                android:id="@+id/btnRegistro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_alt"
                android:text="Crear Una Cuenta"
                android:textColor="#2E7D32"
                android:visibility="gone" />

            <!-- Botón de Google (con error corregido) -->

        </LinearLayout>
    </ScrollView>

    <!-- Este debe ser el ÚLTIMO elemento para que se superponga -->
    <FrameLayout
        android:id="@+id/loadingFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>
</FrameLayout>