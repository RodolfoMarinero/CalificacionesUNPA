<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAEAEA"> <ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp"
    android:paddingHorizontal="24dp"
    android:paddingBottom="80dp"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/btnIzquierdo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            app:tint="@color/unpa_bg_dark" />

        <TextView
            android:id="@+id/btnSemestre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2022-2023-B"
            android:textSize="16sp"
            android:textColor="@color/unpa_bg_dark"
            android:background="@drawable/bg_edittext_modern" android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="16dp"/>

        <ImageView
            android:id="@+id/btnDerecho"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_next"
            app:tint="@color/unpa_bg_dark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button_modern" android:backgroundTint="@color/unpa_green_medium"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Materia"
            android:textColor="@color/unpa_white"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cal. Def."
            android:textColor="@color/unpa_white"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
</ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnDescargarPdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        app:backgroundTint="@color/unpa_white"
        app:tint="@color/unpa_green_medium"
        android:src="@drawable/ic_pdf_download" />
    <View
        android:id="@+id/blurOverlaySpinner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"/>

    <FrameLayout
        android:id="@+id/contenedorSpinner"
        android:layout_width="match_parent"
        android:layout_height="393dp"
        android:layout_gravity="bottom"
        android:background="#CCFFFFFF"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSemestres"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />
    </FrameLayout>
</FrameLayout>