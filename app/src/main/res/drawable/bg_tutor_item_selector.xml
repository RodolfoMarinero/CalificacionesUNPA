<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5F3FF"/>
            <stroke android:width="1.5dp" android:color="@color/purple_primary"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F9FAFB"/>
            <stroke android:width="1dp" android:color="#E5E7EB"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_card"/>
            <stroke android:width="1dp" android:color="@color/border_default"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>